DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_copilot
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

FRONTEND_BASE_URL=http://localhost:5500

# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Add GOOGLE_REDIRECT_URI below as an
# authorized redirect URI there -- it must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Leave SMTP_HOST empty to log password-reset links instead of emailing them
# (fine for local dev/testing). Example for Gmail: smtp.gmail.com, port 587, and an
# app password (not your normal password) -- https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@portfolio-copilot.local
SMTP_USE_TLS=true
